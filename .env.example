# Copy this file to .env and fill in your values

# Folder to scan recursively for .mkv files
SOURCE_DIR=C:\video

# Root folder for renamed/converted output (Movies/ and Shows/ subfolders
# are created underneath it automatically)
DEST_DIR=

# Full path to HandBrakeCLI.exe (leave blank to search PATH automatically)
HANDBRAKE_CLI_PATH=

# Preset for standard-definition sources (DVD, <=576 lines), and the fallback
# when a source's resolution can't be read. Must match
# `HandBrakeCLI --preset-list` exactly.
HANDBRAKE_PRESET=Super HQ 1080p30 Surround

# Preset for HD sources (Blu-ray, >576 lines). Leave blank to use
# HANDBRAKE_PRESET for everything.
HANDBRAKE_PRESET_HD=HQ 1080p30 Surround

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# Share of the machine's logical processors HandBrake may use (1-100, 100 = uncapped)
HANDBRAKE_CPU_PERCENT=100
