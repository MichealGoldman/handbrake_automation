# Copy this file to .env and fill in your values

# Folder to scan recursively for .mkv files
SOURCE_DIR=C:\video

# Root folder for renamed/converted output (Movies/ and TV Shows/ subfolders
# are created underneath it automatically)
DEST_DIR=C:\Users\user\Videos

# Full path to HandBrakeCLI.exe (leave blank to search PATH automatically)
HANDBRAKE_CLI_PATH=

# HandBrake preset to encode with (must match `HandBrakeCLI --preset-list` exactly)
HANDBRAKE_PRESET=Super HQ 1080p30 Surround

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=
